#!/bin/zsh

# ============================================================================
# claude-app-unlink - Remove the macOS Library symlinks created by claude-app
# ============================================================================
#
# Usage:
#   claude-app-unlink            # remove all Claude.app profile symlinks
#   claude-app-unlink -n         # dry-run: show what would be removed
#   claude-app-unlink -h         # help
#
# claude-app swaps symlinks so that Claude.app's macOS Library data folders
# point into the active profile (~/.claude-<profile>/app/...). This command
# removes those symlinks, restoring Claude.app to its default (unlinked) state.
#
# SAFETY:
#   - ONLY symlinks are removed. A real directory is NEVER deleted.
#   - The profile storage (~/.claude-*/app/...) that the links point to is
#     left completely untouched — only the Library-side links are removed.
#   - Claude CLI data (~/.claude-*/cli, ~/.claude.json, ~/.config/claude) is
#     never referenced.
#
# ============================================================================

# Note: We don't use 'set -e' to allow better error handling

# ============================================================================
# Configuration
# ============================================================================

readonly SCRIPT_NAME="${0:t}"
readonly SCRIPT_DIR="${0:A:h}"
readonly HOME_DIR="$HOME"

source "$SCRIPT_DIR/../lib/colors.sh"
source "$SCRIPT_DIR/../lib/messages.sh"
source "$SCRIPT_DIR/../lib/app-storage.sh"

# ============================================================================
# Unlink
# ============================================================================

# Remove every Library symlink created by claude-app.
#   $1 = dry_run flag ("1" to only report, "0" to actually remove)
unlink_all() {
  local dry_run="$1"
  local key library_path target
  local removed=0 skipped=0

  for key in "${(@k)APP_STORAGE_MAP}"; do
    library_path="${APP_STORAGE_MAP[$key]}"

    if [[ -L "$library_path" ]]; then
      # readlink to show where it currently points (profile it belongs to)
      target="$(readlink "$library_path")"

      if [[ "$dry_run" == "1" ]]; then
        print_info "Would unlink: ${library_path/#$HOME_DIR/~} → ${target/#$HOME_DIR/~}"
      else
        if rm -f "$library_path"; then
          print_success "Unlinked: ${library_path/#$HOME_DIR/~} (was → ${target/#$HOME_DIR/~})"
          removed=$((removed + 1))
        else
          print_error "Could not remove symlink: ${library_path/#$HOME_DIR/~}"
        fi
      fi
    elif [[ -e "$library_path" ]]; then
      # A real directory/file lives here — never touch it.
      print_warning "Skipped (not a symlink, left intact): ${library_path/#$HOME_DIR/~}"
      skipped=$((skipped + 1))
    fi
    # Missing entirely → nothing to do, stay silent.
  done

  echo ""
  if [[ "$dry_run" == "1" ]]; then
    print_info "Dry-run finished — nothing was changed."
  elif [[ $removed -eq 0 ]]; then
    print_info "No Claude.app symlinks to remove."
    [[ $skipped -gt 0 ]] && print_info "$skipped real path(s) left intact."
  else
    print_success "Removed $removed symlink(s)."
    [[ $skipped -gt 0 ]] && print_info "$skipped real path(s) left intact."
  fi
}

# ============================================================================
# Usage
# ============================================================================

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [-n] [-h]

Remove the macOS Library symlinks created by claude-app, restoring
Claude.app to its default (unlinked) state.

Options:
  -n    Dry-run: show what would be removed without changing anything
  -h    Show this help

Only symlinks are removed. Real directories and the profile storage
(~/.claude-*/app/...) are never touched.
EOF
}

# ============================================================================
# Main
# ============================================================================

main() {
  local dry_run=0

  while getopts ":nh" opt; do
    case "$opt" in
      n) dry_run=1 ;;
      h) usage; return 0 ;;
      \?) print_error "Unknown option: -$OPTARG"; echo ""; usage; return 1 ;;
    esac
  done

  # Warn (but don't block) if Claude.app is running — removing the links while
  # it's open won't corrupt the current session (open file handles persist),
  # but the app will recreate default folders on its next launch.
  if pgrep -x "Claude" >/dev/null 2>&1; then
    print_warning "Claude.app est en cours d'exécution — les liens sont retirés, mais fermez l'app pour repartir proprement."
  fi

  if [[ "$dry_run" == "1" ]]; then
    print_info "Dry-run: removal of Claude.app profile symlinks"
  else
    print_info "Removing Claude.app profile symlinks"
  fi
  echo ""

  unlink_all "$dry_run"
}

# ============================================================================
# Entry Point
# ============================================================================

main "$@"
